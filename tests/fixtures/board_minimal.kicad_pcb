(kicad_pcb
  (version 20240108)
  (general (thickness 1.6))
  (layers
    (0 "F.Cu" signal)
    (2 "B.Cu" signal)
    (9 "F.Adhes" user)
    (25 "Edge.Cuts" user))
  (setup
    (min_track_width 0.075)
    (min_via_drill 0.2)
    (stackup
      (layer "F.Cu" (type "copper") (thickness 0.035))
      (layer "dielectric 1" (type "core") (thickness 1.51) (material "FR4"))
      (layer "B.Cu" (type "copper") (thickness 0.035))
      (copper_finish "ENIG")))
  (gr_line (start 10 20) (end 50 20) (layer "Edge.Cuts"))
  (gr_line (start 50 20) (end 50 30) (layer "Edge.Cuts"))
  (gr_line (start 50 30) (end 10 30) (layer "Edge.Cuts"))
  (gr_line (start 10 30) (end 10 20) (layer "Edge.Cuts"))
  (footprint "Resistor_SMD:R_0603_1608Metric"
    (layer "F.Cu")
    (property "Reference" "R1")
    (attr smd))
  (footprint "Connector_THT:USB_B"
    (layer "B.Cu")
    (property "Reference" "J1")
    (attr through_hole))
  (footprint "Package_BGA:BGA-4_2x2_0.5mm"
    (layer "F.Cu")
    (property "Reference" "U1")
    (property "Programming" "yes")
    (attr smd)
    (pad "1" smd circle (at 0 0) (size 0.25 0.25))
    (pad "2" smd circle (at 0.5 0) (size 0.25 0.25))
    (pad "3" smd circle (at 0 0.5) (size 0.25 0.25))
    (pad "4" smd circle (at 0.5 0.5) (size 0.25 0.25))))
