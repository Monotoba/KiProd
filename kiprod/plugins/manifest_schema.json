{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiprod.dev/schemas/supplier-manifest/v1.json",
  "title": "KiProd plugin manifest",
  "type": "object",
  "required": ["id", "name", "version"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "pattern": "^\\S+$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "homepage": {"type": "string", "format": "uri"},
    "resources": {"type": "array", "items": {"type": "string"}},
    "region": {
      "type": "object",
      "properties": {
        "country": {"type": "string"},
        "ships_from": {"type": "array", "items": {"type": "string"}},
        "currency": {"type": "string", "minLength": 3, "maxLength": 3}
      },
      "additionalProperties": true
    },
    "adapter": {
      "type": "object",
      "required": ["class"],
      "properties": {
        "module": {"type": "string", "default": "adapter"},
        "class": {"type": "string", "minLength": 1},
        "min_core": {"type": "string"}
      },
      "additionalProperties": true
    },
    "credentials": {"type": "array", "items": {"type": "object", "required": ["key", "label"], "properties": {"key": {"type": "string"}, "label": {"type": "string"}, "secret": {"type": "boolean"}}, "additionalProperties": true}},
    "permissions": {
      "type": "object",
      "properties": {
        "network": {"type": "array", "items": {"type": "string"}},
        "email": {"type": "boolean"},
        "browser": {"type": "boolean"},
        "filesystem_write_outside_run": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "capabilities": {"type": "object"},
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "label": {"type": "string"},
          "type": {"enum": ["string", "text", "int", "float", "bool", "enum", "multi_enum", "date", "file", "secret", "table", "group"]},
          "options": {"type": "array"},
          "default": {},
          "applies_to": {"type": "array", "items": {"type": "string"}},
          "required_if": {},
          "visible_if": {},
          "min": {"type": "number"},
          "max": {"type": "number"},
          "pattern": {"type": "string"},
          "help": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
